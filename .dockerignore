# Dependencies (installed fresh inside the image)
node_modules

# Next.js build output (rebuilt inside the image)
.next
out

# Local dev database and uploaded files — never bake user data into the image;
# these live in mounted volumes at runtime instead.
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.db-journal
public/uploads

# Env files — real secrets are passed in at runtime via docker-compose/--env-file,
# never baked into the image. (Templates like .env.docker.example are harmless but
# also unnecessary at runtime, so they're excluded too.)
.env*

# Editor/OS cruft
.vscode
.idea
.DS_Store
Thumbs.db

# Version control / misc
.git
.gitignore
*.log
npm-debug.log*

# Docs (not needed at runtime)
*.md
