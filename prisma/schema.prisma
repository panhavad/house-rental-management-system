generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum RoomStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

enum ContractStatus {
  ACTIVE
  ENDED
  TERMINATED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum UtilityType {
  WATER
  ELECTRICITY
}

enum Currency {
  USD
  KHR
}

model Workspace {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  isActive             Boolean   @default(true)
  onboardingCompletedAt DateTime?
  /// Marks the single, always-replaceable demo workspace created by the super admin's
  /// "Load demo data" action, so it can be found and torn down without touching any
  /// real workspace/user.
  isDemo               Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users            User[]
  apartments       Apartment[]
  facilities       Facility[]
  utilityRates     UtilityRate[]
  appSetting       AppSetting?
  rolePermissions  RolePermission[]
  activityLogs     ActivityLog[]
  contractTemplate ContractTemplate?
  paymentMethods   PaymentMethod[]
}

/**
 * Remembers which workspace a login email should jump straight into when the
 * same email has valid credentials for more than one workspace (or both a
 * workspace and the platform Super Admin). Deliberately has no foreign key to
 * Workspace: if the referenced workspace is later deleted, this row is simply
 * ignored by anything that reads it (falls back to showing the picker again)
 * instead of needing cascading cleanup.
 */
model LoginPreference {
  email              String   @id
  defaultWorkspaceId String?
  updatedAt          DateTime @updatedAt
}

/// Platform-wide editable translations. English source text lives in the
/// application catalog; each additional language stores only its overrides.
model LanguagePack {
  code         String   @id
  name         String
  nativeName   String
  translations String   @default("{}")
  updatedAt    DateTime @updatedAt
}

/**
 * Platform-wide settings that belong to the deployment itself rather than to any
 * one workspace — currently just maintenance mode. Always a single row, pinned to
 * the fixed id `platform` (see src/lib/maintenance.ts) so it can be read/upserted
 * without first looking up which row is "the" row.
 */
model PlatformSetting {
  id                   String    @id
  /// While true, everyone except the Super Admin is locked out of the app and
  /// sent to /maintenance, so a system update can run without concurrent writes.
  maintenanceMode      Boolean   @default(false)
  /// Optional note shown to locked-out users ("back at 9pm", ...).
  maintenanceMessage   String?
  /// When the current maintenance window was started. Null while not in maintenance.
  maintenanceStartedAt DateTime?
  /// The Super Admin who last flipped the switch, kept for the audit trail. No
  /// foreign key on purpose: the setting must survive that account being deleted.
  maintenanceById      String?
  updatedAt            DateTime  @updatedAt
}

model AppSetting {
  id           String   @id @default(cuid())
  workspaceId  String   @unique
  currency     Currency @default(USD)
  exchangeRate Float    @default(4100)
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/**
 * A way tenants can pay their rent/utility bill (bank transfer, e-wallet QR,
 * cash, ...), configured by the workspace admin and printed on generated
 * invoices so the tenant knows exactly how to send payment. A workspace can
 * have several (e.g. one bank account plus one e-wallet QR).
 */
model PaymentMethod {
  id            String   @id @default(cuid())
  workspaceId   String
  label         String
  bankName      String?
  accountName   String?
  accountNumber String?
  qrImageUrl    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/**
 * One editable lease-agreement template per workspace (falls back to the
 * built-in default when absent). Plain text using `{{placeholder}}` tokens
 * plus a lightweight markup: a leading `# Title` line overrides the document
 * title, `## Heading` starts a numbered section, and lines shaped like
 * `Label: {{value}}` render as a labeled field that's silently omitted when
 * the value is empty — see src/lib/contract-pdf.ts for the renderer.
 */
model ContractTemplate {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  content     String
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model RolePermission {
  workspaceId String
  role        Role
  permission  String
  allowed     Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, role, permission])
}

model ActivityLog {
  id            String   @id @default(cuid())
  workspaceId   String
  entityType    String
  entityId      String
  roomId        String?
  action        String
  description   String
  metadata      String?
  performedById String?
  createdAt     DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  performedBy User?     @relation(fields: [performedById], references: [id])
  room        Room?     @relation(fields: [roomId], references: [id])
}

model Apartment {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  address     String?
  description String?
  mapUrl      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rooms     Room[]
}

model Contract {
  id                String         @id @default(cuid())
  roomId            String
  tenantName        String
  tenantPhone       String?
  tenantEmail       String?
  tenantIdNumber    String?
  occupants         Int            @default(1)
  rentalFee         Float
  deposit           Float          @default(0)
  /// Water meter reading at move-in, used as the "previous reading" baseline for
  /// this tenancy's first utility bill. Defaults to the room's latest historical
  /// reading when the contract is started, but can be overridden.
  waterMeterStart       Float          @default(0)
  electricityMeterStart Float          @default(0)
  /// When true, the utilities below can be billed at a flat monthly price
  /// instead of by meter usage. Each utility is still independent: a null
  /// price means that utility stays on the dynamic/post-paid meter billing.
  fixedUtilityEnabled   Boolean        @default(false)
  fixedWaterFee         Float?
  fixedElectricityFee   Float?
  startDate         DateTime
  endDate           DateTime
  status            ContractStatus @default(ACTIVE)
  terminatedAt      DateTime?
  terminationReason String?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  room      Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  payments  Payment[]
  documents ContractDocument[]
}

model ContractDocument {
  id           String   @id @default(cuid())
  contractId   String
  url          String
  thumbnailUrl String?
  fileType     String
  createdAt    DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model Facility {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  icon        String?
  createdAt   DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rooms     RoomFacility[]

  @@unique([workspaceId, name])
}

model Payment {
  id               String        @id @default(cuid())
  roomId           String
  contractId       String?
  utilityReadingId String?       @unique
  month            String
  rentalFee        Float
  utilityAmount    Float         @default(0)
  totalAmount      Float
  status           PaymentStatus @default(PENDING)
  dueDate          DateTime?
  paidAt           DateTime?
  paidAmount       Float?
  method           String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  utilityReading UtilityReading? @relation(fields: [utilityReadingId], references: [id])
  contract       Contract?       @relation(fields: [contractId], references: [id])
  room           Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, month])
}

model Room {
  id           String     @id @default(cuid())
  apartmentId  String
  name         String
  size         Float?
  type         String
  floor        String?
  floorPlanUrl String?
  rentalFee    Float
  status       RoomStatus @default(VACANT)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  apartment       Apartment        @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  activityLogs    ActivityLog[]
  contracts       Contract[]
  payments        Payment[]
  facilities      RoomFacility[]
  utilityReadings UtilityReading[]
}

model RoomFacility {
  roomId     String
  facilityId String

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, facilityId])
}

model User {
  id           String   @id @default(cuid())
  workspaceId  String?
  name         String
  email        String
  passwordHash String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  activityLogs ActivityLog[]

  @@unique([workspaceId, email])
}

model UtilityRate {
  id            String      @id @default(cuid())
  workspaceId   String
  type          UtilityType
  pricePerUnit  Float
  effectiveFrom DateTime    @default(now())
  createdAt     DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UtilityReading {
  id                  String   @id @default(cuid())
  roomId              String
  month               String
  waterPrevious       Float
  waterCurrent        Float
  waterUsage          Float
  waterRate           Float
  waterCost           Float
  electricityPrevious Float
  electricityCurrent  Float
  electricityUsage    Float
  electricityRate     Float
  electricityCost     Float
  totalCost           Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  payment Payment?
  room    Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, month])
}
