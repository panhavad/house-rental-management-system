# Copy this file to .env.docker and fill in real values before deploying with Docker:
#   Copy-Item .env.docker.example .env.docker      (PowerShell)
#   cp .env.docker.example .env.docker             (bash)
#
# Then deploy with:
#   docker compose --env-file .env.docker up -d --build
#
# Keeping this separate from the local-dev ".env" avoids ever accidentally deploying
# with the insecure development AUTH_SECRET.

# Required. Generate a real one with:
#   openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# The public URL this deployment will be reached at. Behind a reverse proxy or
# tunnel (Cloudflare Tunnel, nginx, Traefik, ...) this must be the PUBLIC https
# URL users type in — not http://localhost:3000 — because it is also the origin
# Next.js trusts for Server Actions (form submits and file uploads).
NEXTAUTH_URL=http://localhost:3000

# Optional. Comma-separated extra hostnames the app is served on, if it answers on
# more than one domain. Only needed when a proxy rewrites the Host header and
# Server Actions start failing with a "does not match origin header" error:
#   ALLOWED_ORIGINS=hrm.example.com,www.hrm.example.com
ALLOWED_ORIGINS=

# Host port to publish on (the app itself always listens on 3000 inside the Docker
# network). This is the port the `proxy` container binds — it forwards everything to
# the app and, whenever the app container is stopped or unreachable, serves the
# maintenance page instead of letting the browser show a connection error.
APP_PORT=3000

# Whether the public /signup page (self-service workspace + administrator
# creation) is reachable. Set to "true" to let anyone create their own
# workspace; left as "false" (the default here), the only way to create a
# workspace is via the Super Admin's "New workspace" button in /super-admin —
# recommended for production, so every user in the system is one you created.
ALLOW_SELF_SIGNUP=false
