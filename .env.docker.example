# Copy this file to .env.docker and fill in real values before deploying with Docker:
#   Copy-Item .env.docker.example .env.docker      (PowerShell)
#   cp .env.docker.example .env.docker             (bash)
#
# Then deploy with:
#   docker compose --env-file .env.docker up -d --build
#
# Keeping this separate from the local-dev ".env" avoids ever accidentally deploying
# with the insecure development AUTH_SECRET.

# Required. Generate a real one with:
#   openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# The public URL this deployment will be reached at.
NEXTAUTH_URL=http://localhost:3000

# Host port to publish the app on (container always listens on 3000 internally).
APP_PORT=3000
