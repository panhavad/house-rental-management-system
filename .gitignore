# See https://git-scm.com/docs/gitignore for more about ignoring files.

# ---- Dependencies ----
/node_modules

# ---- Next.js build output ----
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# ---- Testing / coverage ----
/coverage

# ---- Local SQLite database ----
# The schema and migrations are committed; the actual data file is not.
/prisma/*.db
/prisma/*.db-journal
/prisma/dev.db
/prisma/dev.db-journal

# ---- User-uploaded files ----
# Contract documents uploaded through the app — never commit real user data.
/public/uploads/*
!/public/uploads/.gitkeep

# ---- Environment / secrets ----
# Real secrets are never committed. Templates like .env.docker.example are fine.
.env
.env.local
.env.*.local
.env.docker
.env.production

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Misc ----
*.pem
.vercel
